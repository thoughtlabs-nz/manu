# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
wifi_ssid: "YourWifi"
wifi_password: "YourWifiPassword"

# ESPHome native API encryption key (generate: openssl rand -base64 32)
api_encryption_key: "REPLACE_ME_BASE64_32_BYTES"

# Convex HTTP action endpoint (deployment URL uses .convex.site, not .convex.cloud)
convex_ingest_url: "https://your-deployment.convex.site/detections"
convex_snapshot_url: "https://your-deployment.convex.site/snapshots"
# Shared secret the Convex HTTP action checks before accepting a detection
detection_api_key: "Bearer REPLACE_ME_RANDOM_TOKEN"

# Only needed if you enable the MQTT block instead of / alongside Convex
mqtt_broker: "192.168.1.10"
mqtt_username: "esphome"
mqtt_password: "REPLACE_ME"
